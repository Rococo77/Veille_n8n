# Variables du backend (Render). Ne jamais commiter de valeur réelle.
# En production : les saisir dans le dashboard Render (variables `sync: false` de render.yaml).

# Supabase > Connect > "Session pooler" (port 5432, IPv4). Pas le "Transaction pooler" (6543) :
# asyncpg y casse sur les requêtes préparées. ssl=require impose le chiffrement.
VEILLE_DATABASE_URL=postgresql+asyncpg://veille_app.<project-ref>:<mot-de-passe>@aws-0-<region>.pooler.supabase.com:5432/postgres?ssl=require

# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changer cette clé rend illisibles les seconds facteurs existants (réinitialisation requise).
VEILLE_TOTP_ENCRYPTION_KEY=

# Le jeton en clair va UNIQUEMENT dans la credential n8n ; le site ne connaît que son hash.
#   TOKEN=$(openssl rand -base64 48 | tr -d '\n'); echo "$TOKEN"
#   printf '%s' "$TOKEN" | sha256sum | cut -d' ' -f1
VEILLE_INTERNAL_TOKEN_SHA256=

VEILLE_COOKIE_SECURE=true

# Rétention (jours), appliquée par POST /api/internal/purge qu'appelle n8n chaque nuit.
# Optionnel : défauts 180 et 365. Fixée ici et non par l'appelant, volontairement.
# VEILLE_ARTICLE_RETENTION_DAYS=180
# VEILLE_AUDIT_RETENTION_DAYS=365

# Invitations par mail (Brevo, API HTTPS). Sans clé, aucun mail ne part : l'admin reçoit
# le lien d'activation dans le panel et le transmet lui-même.
# Brevo > SMTP & API > Clés API. Le domaine d'expédition doit être authentifié chez Brevo
# (DKIM + SPF + DMARC dans la zone DNS OVH de bytenorth.fr).
# VEILLE_MAIL_API_KEY=
# VEILLE_MAIL_FROM=veille@bytenorth.fr
# VEILLE_MAIL_REPLY_TO=contact@bytenorth.fr
# VEILLE_PUBLIC_BASE_URL=https://veille-n8n.vercel.app
# VEILLE_INVITATION_HOURS=48
